#!/usr/bin/env node
'use strict';

const { version } = require('../package.json');

const args = process.argv.slice(2);

if (args.includes('--version') || args.includes('-v')) {
  console.log(version);
  process.exit(0);
}

console.error('pathkit: unknown or missing command. Supported: --version');
process.exit(1);
